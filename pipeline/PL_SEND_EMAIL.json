{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Get  Complete Status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 10,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_SERVER_2",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Get  Failed Count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 10,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}' and status != 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_SERVER_2",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get  Failed Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "PROD | @{\r\n    if(\r\n        greater(\r\n        activity('Get  Failed Count').output.firstRow.count,0),\r\n        'FAILED','SUCCESS' \r\n    )\r\n} |CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "header",
					"value": "Ingesiton is completed and status is below"
				}
			},
			{
				"name": "footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "footer",
					"value": "for any support reach out to abc@gmail.com"
				}
			},
			{
				"name": "recepients",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "recepients",
					"value": {
						"value": "@pipeline().globalParameters.email_recepient",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Logic Apps Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "recepients",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Status Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\"@{variables('subject')}\",\n\"header\":\"@{variables('header')}\",\n\"footer\":\"@{variables('footer')}\",\n\"receipents\":\"@{pipeline().globalParameters.email_recepient}\",\n\"status_table\":@{variables('status_table')}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set Status Table",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get  Complete Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "status_table",
					"value": {
						"value": "@string(activity('Get  Complete Status').output.value)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Web1",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Logic Apps Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_apps_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a01d70b5-0d4a-4c6a-9fbb-f76d2f350e9d"
			}
		},
		"variables": {
			"subject": {
				"type": "String"
			},
			"header": {
				"type": "String"
			},
			"footer": {
				"type": "String"
			},
			"recepients": {
				"type": "String"
			},
			"status_table": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}